+	/** Respuesta final con Google Search grounding (endpoint nativo). Misma forma de retorno que call_gemini_api() + 'grounding' (groundingMetadata). El clasificador NO usa búsqueda. */
+	private function call_gemini_search_api( $api_key, $model, $system_prompt, $messages, $max_tokens ) {
+		$host     = wp_parse_url( home_url(), PHP_URL_HOST );
+		$contents = array();
+		foreach ( $messages as $message ) {
+			$contents[] = array(
+				'role'  => ( 'assistant' === $message['role'] ) ? 'model' : 'user',
+				'parts' => array( array( 'text' => $message['content'] ) ),
+			);
+		}
+
+		$body = array(
+			'systemInstruction' => array(
+				'parts' => array( array( 'text' => $system_prompt . "\n\n--- Google Search: toda consulta debe llevar site:{$host}. Usa SOLO información de páginas de {$host}; ignora cualquier otro sitio. Si {$host} no tiene la respuesta, dilo y no inventes ni uses conocimiento externo sobre precios, stock o productos." ) ),
+			),
+			'contents'          => $contents,
+			'tools'             => array( array( 'google_search' => new stdClass() ) ), // stdClass: debe serializar como {} y no [].
+			'generationConfig'  => array( 'maxOutputTokens' => $max_tokens ),
+		);
+
+		$response = wp_remote_post(
+			sprintf( self::GEMINI_NATIVE_ENDPOINT, rawurlencode( $model ) ),
+			array(
+				'headers' => array(
+					'x-goog-api-key' => $api_key,
+					'content-type'   => 'application/json',
+				),
+				'body'    => wp_json_encode( $body ),
+				'timeout' => 45,
+			)
+		);
+
+		if ( is_wp_error( $response ) ) {
+			return $response;
+		}
+
+		$status = wp_remote_retrieve_response_code( $response );
+		$data   = json_decode( wp_remote_retrieve_body( $response ), true );
+
+		if ( $status < 200 || $status >= 300 ) {
+			return new WP_Error(
+				'lac_api_error',
+				isset( $data['error']['message'] ) ? $data['error']['message'] : 'Error desconocido al llamar a la API.',
+				array(
+					'http_code' => $status,
+					'api_code'  => isset( $data['error']['code'] ) ? $data['error']['code'] : 'N/A',
+					'status'    => isset( $data['error']['status'] ) ? $data['error']['status'] : 'lac_api_error',
+				)
+			);
+		}
+
+		$candidate = $data['candidates'][0] ?? array();
+		$text      = '';
+		foreach ( $candidate['content']['parts'] ?? array() as $part ) {
+			$text .= $part['text'] ?? '';
+		}
+
+		if ( '' === trim( $text ) ) {
+			return new WP_Error( 'lac_empty_reply', 'La API no devolvió texto.' );
+		}
+
+		// 'raw' imita la forma OpenAI para que los logs [06]-[08] sigan funcionando sin tocarlos.
+		return array(
+			'text'      => $text,
+			'raw'       => array(
+				'choices'        => array( array( 'finish_reason' => $candidate['finishReason'] ?? 'N/A', 'message' => array( 'content' => $text ) ) ),
+				'usage'          => array( 'completion_tokens' => $data['usageMetadata']['candidatesTokenCount'] ?? 'N/A' ),
+				'promptFeedback' => $data['promptFeedback'] ?? array(),
+			),
+			'grounding' => $candidate['groundingMetadata'] ?? array(),
+		);
+	}
+
+	/** groundingMetadata.groundingChunks[].web -> [{title,url}]. Los uri son redirects de Google: se resuelven y SOLO se conservan los que terminan en el dominio del sitio (máx. 3). Título = título real del post/producto vía url_to_postid(). */
+	private function extract_grounding_sources( $grounding ) {
+		$host    = preg_replace( '/^www\./', '', (string) wp_parse_url( home_url(), PHP_URL_HOST ) );
+		$sources = array();
+		foreach ( array_slice( $grounding['groundingChunks'] ?? array(), 0, 6 ) as $chunk ) {
+			$uri = $chunk['web']['uri'] ?? '';
+			if ( '' === $uri || false === stripos( $chunk['web']['title'] ?? '', $host ) ) {
+				continue;
+			}
+
+			$res = wp_remote_get( $uri, array( 'redirection' => 0, 'timeout' => 3 ) );
+			$url = is_wp_error( $res ) ? '' : wp_remote_retrieve_header( $res, 'location' );
+			if ( ! is_string( $url ) || '' === $url ) {
+				continue;
+			}
+
+			$url_host = preg_replace( '/^www\./', '', (string) wp_parse_url( $url, PHP_URL_HOST ) );
+			if ( $url_host !== $host ) {
+				continue;
+			}
+
+			$url = esc_url_raw( remove_query_arg( array( 'utm_source', 'utm_medium' ), $url ) );
+			if ( isset( $sources[ $url ] ) ) {
+				continue;
+			}
+
+			$post_id = url_to_postid( $url );
+			$label   = $post_id ? get_the_title( $post_id ) : sanitize_text_field( $chunk['web']['title'] );
+
+			$sources[ $url ] = array(
+				'title' => wp_strip_all_tags( $label ),
+				'url'   => add_query_arg( array( 'utm_source' => 'limatco', 'utm_medium' => 'chatbot' ), $url ),
+			);
+			if ( count( $sources ) >= 3 ) {
+				break;
+			}
+		}
+		return array_values( $sources );
+	}
